# Add these configurations to your .env file for proper chat functionality

# Default Model Configuration
OPENWEBUI_DEFAULT_MODEL="qwen2.5:3b"
OLLAMA_DEFAULT_MODEL="llama3.2:3b"

# Chat System Configuration
CHAT_DEFAULT_PROVIDER="openwebui"
CHAT_SESSION_RETENTION_DAYS=30
CHAT_MAX_SESSIONS_PER_USER=10
CHAT_MAX_SESSIONS_DISPLAY=10

# Chat UI Configuration
CHAT_ENABLE_SESSION_DELETE=true
CHAT_CONFIRM_SESSION_DELETE=true
CHAT_SHOW_SESSIONS_BY_DEFAULT=false
CHAT_ENABLE_SESSION_CLEANUP=true

# OpenWebUI Configuration
OPENWEBUI_ENABLED=true
OPENWEBUI_BASE_URL="http://localhost:3000"
OPENWEBUI_API_KEY=""
OPENWEBUI_TIMEOUT=30

# Ollama Configuration (optional fallback)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TIMEOUT=60
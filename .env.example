APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ximopet.local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Chat Configuration
# Ollama Settings
OLLAMA_API_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama2
OLLAMA_TIMEOUT=30
OLLAMA_MAX_TOKENS=1000
OLLAMA_TEMPERATURE=0.7

# OpenWebUI Settings
OPENWEBUI_BASE_URL=http://localhost:3000
OPENWEBUI_API_KEY=
OPENWEBUI_DEFAULT_MODEL=llama2
OPENWEBUI_TIMEOUT=30
OPENWEBUI_MAX_TOKENS=1000
OPENWEBUI_TEMPERATURE=0.7

# Chat System Settings
CHAT_ENABLED=true
CHAT_MAX_MESSAGE_LENGTH=5000
CHAT_SESSION_TIMEOUT=3600
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_HOUR=100
CHAT_RATE_LIMIT_PER_DAY=500
CHAT_RATE_LIMIT_BURST=5
CHAT_CONTEXT_CACHE_TTL=300
CHAT_DEFAULT_PROVIDER=ollama
CHAT_ENABLE_SOUND_NOTIFICATIONS=true
CHAT_ENABLE_TYPING_INDICATOR=true
CHAT_AUTO_SCROLL=true
CHAT_SAVE_HISTORY=true
CHAT_DEBUG_MODE=false

# AI Chat V2 Settings
AI_CHAT_V2_ENABLED=true
AI_CHAT_V2_DEFAULT_PROVIDER=openwebui
AI_CHAT_V2_DEFAULT_MODEL=llama3.2:3b

# Chat Alert Auto-close Settings
CHAT_ALERTS_AUTOCLOSE_ENABLED=true
CHAT_ALERTS_AUTOCLOSE_DURATION=60
CHAT_ALERTS_SHOW_COUNTDOWN=true
CHAT_ALERTS_COUNTDOWN_POSITION=right
CHAT_ALERTS_PAUSE_ON_HOVER=true
